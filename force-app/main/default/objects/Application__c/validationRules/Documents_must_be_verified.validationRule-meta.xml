<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Documents_must_be_verified</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Stage__c, &quot;Joining Letter Sent&quot;),
    NOT(Documents_Verified__c)
)</errorConditionFormula>
    <errorMessage>Documents must be verified before the Application can move to Joining Letter Sent.</errorMessage>
</ValidationRule>
