<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Offer_Approval_Requires_Hire</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Stage__c, &quot;Offer Approval&quot;),
    NOT(ISPICKVAL(Interview_Recommendation__c, &quot;Hire&quot;))
)</errorConditionFormula>
    <errorMessage>Application cannot move to Offer Approval until the interview recommendation is Hire.</errorMessage>
</ValidationRule>
